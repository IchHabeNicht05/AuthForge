# ─────────────────────────────────────────────────────────────────────────
# AuthForge — environment variables
# Copy this file to .env and fill in real values. Nothing in the codebase
# has a hardcoded secret; everything below is read via src/lib/env.ts,
# which validates presence/shape at boot (see that file for details).
# ─────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Local dev example:
# postgresql://postgres:postgres@localhost:5432/authforge
DATABASE_URL=

# Signs session tokens & CSRF tokens, and derives the AES-256 key used to
# encrypt TOTP secrets at rest. Minimum 32 characters. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET=

# Optional: set this to the PREVIOUS value of AUTH_SECRET while rotating,
# so tokens signed before the rotation still validate during the overlap
# window.
AUTH_SECRET_PREVIOUS=

# Base URL of this app, used to build links in emails (verify, reset).
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ── OAuth providers (optional — email/password works with none of these set) ──
# Google: https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
#   Authorization callback URL: {APP_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Rate limiting (optional) ──
# If unset, an in-memory limiter is used (fine for local dev only — it does
# not share state across serverless instances). For production, configure
# an Upstash Redis REST database: https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Outbound email (optional) ──
# If unset, emails (verification, password reset) are logged to the server
# console instead of sent. Configure a Resend API key for real delivery:
# https://resend.com
EMAIL_FROM=
RESEND_API_KEY=

NODE_ENV=development
